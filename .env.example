# Copy this file to .env before starting local infrastructure or backend services.
# Keep each POSTGRES_PASSWORD value aligned with its matching connection string.
# Non-secret service defaults belong in GameService/Config and SimulationWorker/Config.
# Use 127.0.0.1, not localhost: Docker publishes the ports on IPv4 loopback only, and on
# Windows every new connection to localhost first waits about two seconds for ::1 to fail.
POSTGRES_DB=shooter_mmo
POSTGRES_USER=shooter_mmo
POSTGRES_PASSWORD=replace-with-local-postgres-password
ConnectionStrings__Postgres=Host=127.0.0.1;Port=5432;Database=shooter_mmo;Username=shooter_mmo;Password=replace-with-local-postgres-password
ConnectionStrings__Redis=127.0.0.1:6379
SIMULATION_WORKER_SERVICE_SECRET=replace-with-a-long-local-simulation-worker-secret
DevelopmentSimulationBots__Enabled=false
ACTIVE_SIMULATION_BOTS_SECRET=replace-with-a-separate-long-development-bot-secret

TEST_POSTGRES_DB=shooter_mmo_tests
TEST_POSTGRES_USER=shooter_mmo_tests
TEST_POSTGRES_PASSWORD=replace-with-local-test-postgres-password
MMORPG_TEST_POSTGRES=Host=127.0.0.1;Port=55432;Database=shooter_mmo_tests;Username=shooter_mmo_tests;Password=replace-with-local-test-postgres-password
MMORPG_TEST_REDIS=127.0.0.1:56380
