# Copy this file to .env before starting local infrastructure or backend services.
# Keep each POSTGRES_PASSWORD value aligned with its matching connection string.
POSTGRES_DB=shooter_mmo
POSTGRES_USER=shooter_mmo
POSTGRES_PASSWORD=replace-with-local-postgres-password
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=shooter_mmo;Username=shooter_mmo;Password=replace-with-local-postgres-password
ConnectionStrings__Redis=localhost:6379
WORLD_SERVER_ID=local-world-1
WORLD_SERVER_SERVICE_SECRET=replace-with-a-long-local-world-server-secret

TEST_POSTGRES_DB=shooter_mmo_tests
TEST_POSTGRES_USER=shooter_mmo_tests
TEST_POSTGRES_PASSWORD=replace-with-local-test-postgres-password
SHOOTER_MMO_TEST_POSTGRES=Host=localhost;Port=55432;Database=shooter_mmo_tests;Username=shooter_mmo_tests;Password=replace-with-local-test-postgres-password
