{
  "name": "development CI gate",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/development"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "Backend checks and unit tests", "integration_id": 15368 },
          { "context": "Integration tests (items)", "integration_id": 15368 },
          { "context": "Integration tests (other)", "integration_id": 15368 },
          { "context": "Observability configuration", "integration_id": 15368 },
          { "context": "Unity quality gate", "integration_id": 15368 }
        ]
      }
    }
  ]
}
