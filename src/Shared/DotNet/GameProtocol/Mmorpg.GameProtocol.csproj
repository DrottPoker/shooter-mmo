<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET Standard 2.1 is what Unity compiles; the .NET 10 build adds the platform's
         ChaCha20-Poly1305 for the worker and the tools. Both stay at C# 8, Unity's floor. -->
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <LangVersion>8.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- A glob keeps every Unity protocol source in the .NET server build. -->
    <Compile Include="..\..\GameProtocol\Runtime\**\*.cs"
             Link="Runtime\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
