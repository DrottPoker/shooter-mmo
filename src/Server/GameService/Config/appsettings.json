{
  "HealthChecks": {
    "TimeoutMilliseconds": 1000
  },
  "Http": {
    "TrustedProxies": "",
    "ForwardLimit": 1,
    "MaxRequestHeadersTotalSizeBytes": 16384,
    "MaxRequestHeaderCount": 64,
    "MaxRequestLineSizeBytes": 4096,
    "RequestHeadersTimeoutSeconds": 15,
    "KeepAliveTimeoutSeconds": 130,
    "ShutdownDrainSeconds": 10,
    "ShutdownTimeoutSeconds": 30
  },
  "Telemetry": {
    "OtlpEndpoint": "",
    "MetricExportIntervalSeconds": 10,
    "TraceSampleRatio": 1.0
  },
  "Database": {
    "RunMigrationsOnStartup": false,
    "MigrationLockTimeoutMilliseconds": 5000,
    "MigrationCommandTimeoutSeconds": 300,
    "MaximumPoolSize": 64
  },
  "Retention": {
    "IntervalSeconds": 60,
    "BatchSize": 1000,
    "PassBudgetPercent": 80,
    "ItemHistory": "14.00:00:00",
    "SessionHistory": "14.00:00:00"
  },
  "Auth": {
    "SessionIdleLifetimeDays": 14,
    "SessionMaximumLifetimeDays": 90
  },
  "RedisAcceleration": {
    "Enabled": true,
    "KeyPrefix": "shooter-mmo",
    "SessionCacheEnabled": true,
    "SessionCacheTtlSeconds": 60,
    "SessionRevocationTombstoneSeconds": 120,
    "AuthenticationRateLimitingEnabled": true,
    "MetricsIntervalSeconds": 30
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Content": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "Public": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "AccountActions": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "AccountReads": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    }
  },
  "Game": {
    "MaxCharactersPerAccount": 5
  },
  "Items": {
    "CatalogPath": "WorldData/Items/core.item-catalog.json",
    "Operations": {
      "TransactionTimeoutMilliseconds": 10000,
      "LockTimeoutMilliseconds": 2000,
      "MaximumCommandPayloadBytes": 65536,
      "MaximumHttpRequestBodyBytes": 262144,
      "MetricsIntervalSeconds": 30,
      "MaintenanceIntervalSeconds": 60,
      "CleanupBatchSize": 64
    },
    "NpcLifecycle": {
      "InsurancePrice": 100
    }
  },
  "Content": {
    "TextTablesPath": "WorldData/Text/en",
    "BaseUrl": ""
  },
  "WorldData": {
    "WorldsPath": "WorldData/Worlds"
  },
  "Simulation": {
    "JoinTicketLifetimeSeconds": 30,
    "SessionLeaseLifetimeSeconds": 150,
    "WorkerHeartbeatTimeoutSeconds": 30,
    "MetricsIntervalSeconds": 15,
    "Topology": {
      "Fleets": [
        {
          "Id": "local-fleet",
          "DisplayName": "Local Development",
          "RegionCode": "LOCAL"
        }
      ],
      "Nodes": [
        {
          "Id": "local-node-1",
          "FleetId": "local-fleet",
          "DisplayName": "Local Node 1"
        }
      ],
      "Shards": [
        {
          "Id": "local-shard-1",
          "FleetId": "local-fleet",
          "DisplayName": "Local Shard 1",
          "RuleSet": "mvp-open-risk"
        },
        {
          "Id": "local-shard-2",
          "FleetId": "local-fleet",
          "DisplayName": "Local Stress Arena",
          "RuleSet": "mvp-open-risk"
        }
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
