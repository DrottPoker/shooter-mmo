{
  "HealthChecks": {
    "TimeoutMilliseconds": 1000
  },
  "Telemetry": {
    "OtlpEndpoint": "",
    "MetricExportIntervalSeconds": 10,
    "TraceSampleRatio": 1.0
  },
  "Database": {
    "RunMigrationsOnStartup": true,
    "MaximumPoolSize": 64
  },
  "Auth": {
    "SessionLifetimeHours": 24
  },
  "RedisAcceleration": {
    "Enabled": true,
    "KeyPrefix": "shooter-mmo",
    "SessionCacheEnabled": true,
    "SessionCacheTtlSeconds": 60,
    "SessionRevocationTombstoneSeconds": 120,
    "AuthenticationRateLimitingEnabled": true,
    "MetricsIntervalSeconds": 30
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "Game": {
    "MaxCharactersPerAccount": 5
  },
  "Items": {
    "CatalogPath": "WorldData/Items/core.item-catalog.json",
    "Operations": {
      "TransactionTimeoutMilliseconds": 10000,
      "LockTimeoutMilliseconds": 2000,
      "MaximumCommandPayloadBytes": 65536,
      "MaximumHttpRequestBodyBytes": 262144,
      "MetricsIntervalSeconds": 30,
      "MaintenanceIntervalSeconds": 60,
      "CleanupBatchSize": 64,
      "AuditRetentionDays": 30,
      "ClosedCorpseRetentionDays": 30
    },
    "NpcLifecycle": {
      "InsurancePrice": 100,
      "QuestGrantId": "quest.local.sealed_letter",
      "QuestItemDefinitionId": "quest_item.sealed_letter",
      "QuestItemQuantity": 1
    }
  },
  "WorldData": {
    "WorldsPath": "WorldData/Worlds"
  },
  "Simulation": {
    "JoinTicketLifetimeSeconds": 30,
    "SessionLeaseLifetimeSeconds": 30,
    "WorkerHeartbeatTimeoutSeconds": 30,
    "MetricsIntervalSeconds": 15,
    "Topology": {
      "Fleets": [
        {
          "Id": "local-fleet",
          "DisplayName": "Local Development",
          "RegionCode": "LOCAL"
        }
      ],
      "Nodes": [
        {
          "Id": "local-node-1",
          "FleetId": "local-fleet",
          "DisplayName": "Local Node 1"
        }
      ],
      "Shards": [
        {
          "Id": "local-shard-1",
          "FleetId": "local-fleet",
          "DisplayName": "Local Shard 1",
          "RuleSet": "mvp-open-risk"
        }
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
