{
  "HealthChecks": {
    "TimeoutMilliseconds": 1000
  },
  "Database": {
    "RunMigrationsOnStartup": true
  },
  "Auth": {
    "SessionLifetimeHours": 24
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "Game": {
    "MaxCharactersPerAccount": 5
  },
  "Simulation": {
    "JoinTicketLifetimeSeconds": 30,
    "SessionLeaseLifetimeSeconds": 30,
    "WorkerHeartbeatTimeoutSeconds": 30,
    "Topology": {
      "Worlds": [
        {
          "Id": "local-world-1",
          "DisplayName": "Local Test World"
        }
      ],
      "Fleets": [
        {
          "Id": "local-fleet",
          "DisplayName": "Local Development",
          "RegionCode": "LOCAL"
        }
      ],
      "Nodes": [
        {
          "Id": "local-node-1",
          "FleetId": "local-fleet",
          "DisplayName": "Local Node 1"
        }
      ],
      "Shards": [
        {
          "Id": "local-shard-1",
          "WorldId": "local-world-1",
          "FleetId": "local-fleet",
          "DisplayName": "Local Shard 1",
          "RuleSet": "mvp-open-risk"
        }
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
