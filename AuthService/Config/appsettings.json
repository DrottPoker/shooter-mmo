{
  "HealthChecks": {
    "TimeoutMilliseconds": 1000
  },
  "Database": {
    "RunMigrationsOnStartup": true
  },
  "Auth": {
    "SessionLifetimeHours": 24
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "Game": {
    "MaxCharactersPerAccount": 5
  },
  "WorldJoin": {
    "TicketLifetimeSeconds": 30
  },
  "WorldSession": {
    "LeaseLifetimeSeconds": 30
  },
  "WorldRegistry": {
    "HeartbeatTimeoutSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
