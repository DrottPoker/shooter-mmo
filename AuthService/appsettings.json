{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=shooter_mmo;Username=shooter_mmo;Password=shooter_mmo_dev_password",
    "Redis": "localhost:6379"
  },
  "HealthChecks": {
    "TcpTimeoutMilliseconds": 1000
  },
  "Database": {
    "RunMigrationsOnStartup": true
  },
  "Auth": {
    "SessionLifetimeHours": 24
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "ServiceAuthentication": {
    "WorldServers": {
      "local-world-1": "local-development-world-server-secret-change-me"
    }
  },
  "Game": {
    "MaxCharactersPerAccount": 5
  },
  "WorldJoin": {
    "TicketLifetimeSeconds": 30
  },
  "WorldSession": {
    "LeaseLifetimeSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
