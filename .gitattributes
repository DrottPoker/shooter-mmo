* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.fbx binary
*.mp3 binary
*.wav binary
*.ogg binary
*.mp4 binary
*.mov binary
*.dll binary
*.bytes binary
*.so binary
*.dylib binary

# Compiled content and generated code are written by tools/Compile-Content.ps1 and the
# protocol generator, so GitHub collapses them in a pull request.
src/Shared/WorldData/Generated/** linguist-generated=true
tests/Fixtures/*/generated/** linguist-generated=true
src/Shared/GameProtocol/Runtime/Generated/** linguist-generated=true

# Blender sources live in Git LFS; CI reads their SHA-256 from the pointer files.
*.blend filter=lfs diff=lfs merge=lfs -text
